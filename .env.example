# Copia in .env. Non condividere il file .env.
LOCAL_MODE=true
APP_ORIGIN=http://127.0.0.1:5180
PORT=8787
DATA_DIR=data
PROXY_MODE=none
SCHEDULER_ENABLED=true

# Database: scegli il motore attivo; per trasferimenti consulta MYSQL.md.
DB_DRIVER=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=click_social
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false
# Certificato CA facoltativo, con MYSQL_SSL=true.
MYSQL_SSL_CA=

# AI: inserisci una chiave del tuo account e i modelli abilitati.
OPENAI_API_KEY=
AI_TEXT_MODEL=gpt-5.6-luna
AI_IMAGE_MODEL=gpt-image-2

# Login Google: callback http://127.0.0.1:5180/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Social: credenziali della societa, solo sul backend. Vedi SOCIAL.md.
# Pagine Facebook: callback pubblico HTTPS /api/social/facebook/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_LOGIN_CONFIG_ID=

# Instagram Login: ID e segreto del prodotto Instagram nell'app Meta aziendale.
# Callback pubblico HTTPS /api/social/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok Login Kit + Content Posting API. Callback /api/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Usa inizialmente credenziali Stripe di test. Nessun prezzo viene inventato.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Se SMTP_HOST e vuoto in locale, le email restano in /dev/mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
