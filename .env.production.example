# Esempio da completare sul server, non contiene credenziali.
# Non sostituire un .env esistente. Leggi PLESK.md prima di avviare l'app.
NODE_ENV=production
LOCAL_MODE=false
# Esempio dimostrativo: sostituisci con il sottodominio HTTPS reale.
APP_ORIGIN=https://clicksocial.example.test
DATA_DIR=data
# Solo se l'app viene avviata da Passenger tramite il pannello Node.js di Plesk.
PROXY_MODE=passenger
# false richiede un'attività pianificata scheduler:run; vedi PLESK.md.
SCHEDULER_ENABLED=false

DB_DRIVER=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false
MYSQL_SSL_CA=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

OPENAI_API_KEY=
# Inserisci i modelli effettivamente abilitati sul tuo account.
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_LOGIN_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
